{
  "name": "smoky",
  "version": "1.13.4",
  "description": "Smoky — multi media downloader. Dark, calm, private by default.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "app:smoke": "electron . --smoke",
    "smoke:test": "node scripts/smoke-test.js",
    "test:updater": "node scripts/test-updater.js",
    "test:covers": "node scripts/test-covers.js",
    "test:organize": "node scripts/test-organize.js",
    "test:spotdl": "node scripts/test-spotdl.js",
    "test:spotdl-skip": "node scripts/test-spotdl-skip.js",
    "test:spotify-embed": "node scripts/test-spotify-embed.js",
    "test:bughunt": "node scripts/test-bughunt.js",
    "test": "npm run smoke:test && npm run test:updater && npm run test:covers && npm run test:organize && npm run test:bughunt",
    "icon": "node scripts/make-icon.js",
    "icon:mac": "node scripts/make-icns.js",
    "dist": "electron-builder --win zip dir",
    "dist:build": "electron-builder --win",
    "update:package": "node scripts/make-update.js",
    "update:dist": "npm run dist && npm run update:package"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.smoky.app",
    "productName": "Smoky",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "server.js",
      "public/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "zip"
        },
        {
          "target": "dir"
        },
        {
          "target": "nsis"
        }
      ]
    },
    "mac": {
      "icon": "electron/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "files": [
        "!tools/**/*.exe"
      ],
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Smoky",
      "artifactName": "Smoky-Setup-${version}.exe"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
